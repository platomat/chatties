# Runtime / local threads & jobs (keep folders via .gitkeep)
/data/threads/*.json
/data/threads/*.tmp
!/data/threads/.gitkeep
/data/jobs/*.json
/data/jobs/*.tmp
/data/jobs/*.lock
/data/jobs/*.log
/data/jobs/*.pid
!/data/jobs/.gitkeep

# Secrets / local env
.env
.env.*
!.env.example

# Composer (falls später)
/vendor/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.code-workspace

# Logs / caches
*.log
.phpunit.result.cache
