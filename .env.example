# Local defaults for the setup form (copy to .env — never commit .env)

# Shared defaults for both agents
CHATTIES_API_URL=http://127.0.0.1:1234/v1
CHATTIES_MODEL=
CHATTIES_API_KEY=

# cURL timeout in seconds for LLM calls (0 = unlimited). Default 1800.
# Slow local models (~3 t/s) need more than 300s.
CHATTIES_HTTP_TIMEOUT=1800

# Optional per-agent overrides
# CHATTIES_API_URL_A=https://api.example.com/v1
# CHATTIES_API_URL_B=https://api.example.com/v1
# CHATTIES_MODEL_A=…
# CHATTIES_MODEL_B=…
# CHATTIES_API_KEY_A=
# CHATTIES_API_KEY_B=
